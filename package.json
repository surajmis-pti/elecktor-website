    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.7",
    "postcss": "^8.5.33",
    "vite": "^5.4.11"
  }
