{
  "name": "elecktor-website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "ELECKTOR INDUSTRIES website – React frontend, Node.js (Express) API, PostgreSQL (Supabase)",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/dev.js\" \"vite\"",
